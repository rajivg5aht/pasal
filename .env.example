# ──────────────────────────────────────────────────
# Pasal — Environment Variables (Template)
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────

# OpenAI / Generative AI API key (used by the GenAI enrichment module)
GENAI_API_KEY=your_api_key_here

# Reserved configuration for the approved services (not implemented yet)
MONGODB_URI=mongodb://127.0.0.1:27017/pasal

# Backend
BACKEND_PORT=3000
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000

# Frontend
FRONTEND_PORT=5173
