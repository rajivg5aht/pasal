# ──────────────────────────────────────────────────
# Pasal — Environment Variables (Template)
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────

# Groq Free organization only; never upgrade or attach a payment method.
# Export these into the process environment; the CLI does not load .env itself.
GROQ_API_KEY=your_api_key_here
# Set to free only after checking the account's billing tier in Groq Console.
GROQ_ACCOUNT_TIER=

# Reserved configuration for the approved services (not implemented yet)
MONGODB_URI=mongodb://127.0.0.1:27017/pasal

# Backend
BACKEND_PORT=3000
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000
# Random backend-to-recommender secret, at least 32 characters; never frontend-visible.
RECOMMENDATION_SERVICE_TOKEN=

# Frontend
FRONTEND_PORT=5173
