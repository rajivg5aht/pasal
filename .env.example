# ──────────────────────────────────────────────────
# Pasal — Environment Variables (Template)
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────

# OpenAI / Generative AI API key (used by the GenAI enrichment module)
GENAI_API_KEY=your_api_key_here

# Database (if you add one later)
# DATABASE_URL=postgresql://user:password@localhost:5432/pasal

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
